rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }
    function approved(org) {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && org in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.orgs);
    }

    // marks who the first (admin) user is
    match /config/admin {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/config/admin);
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // first user becomes admin; everyone else is a trainer with no approvals yet
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'admin'
          && !exists(/databases/$(database)/documents/config/admin))
        || (request.resource.data.role == 'trainer' && request.resource.data.orgs.size() == 0));
      // users may only request access; admins can change anything
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['want']));
    }

    match /students/{id} {
      allow read, update, delete: if approved(resource.data.org);
      allow create: if approved(request.resource.data.org);
    }
    match /curricula/{id} {
      allow read, update, delete: if approved(resource.data.org);
      allow create: if approved(request.resource.data.org);
    }
    match /records/{id} {
      allow read, update, delete: if approved(resource.data.org);
      allow create: if approved(request.resource.data.org);
    }
  }
}